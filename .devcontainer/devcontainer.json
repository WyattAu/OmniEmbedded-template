{
  // Image flavor: zero-setup cross toolchain via apt.
  "name": "OmniEmbedded",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": { "ghcr.io/devcontainers/features/github-cli:1": {} },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y gcc-arm-none-eabi binutils-arm-none-eabi libnewlib-arm-none-eabi cmake ninja-build",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools", "tekumara.typos-vscode", "EditorConfig.EditorConfig", "github.vscode-github-actions"],
      "settings": { "C_Cpp.default.compileCommands": "${workspaceFolder}/build/pico-debug/compile_commands.json", "editor.formatOnSave": true }
    }
  }
}
