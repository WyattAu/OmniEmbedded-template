{
  "version": 6,
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host tests (native)",
      "binaryDir": "${sourceDir}/build/host-debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OMNI_HOST": "ON"
      }
    },
    {
      "name": "pico-debug",
      "displayName": "pico debug",
      "binaryDir": "${sourceDir}/build/pico-debug",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/lib/pico-sdk/cmake/preload/toolchains/pico_arm_cortex_m0plus_gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PICO_BOARD": "pico",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "pico-release",
      "displayName": "pico release",
      "binaryDir": "${sourceDir}/build/pico-release",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/lib/pico-sdk/cmake/preload/toolchains/pico_arm_cortex_m0plus_gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "pico",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "pico2-debug",
      "displayName": "pico2 debug",
      "binaryDir": "${sourceDir}/build/pico2-debug",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/lib/pico-sdk/cmake/preload/toolchains/pico_arm_cortex_m33_gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PICO_BOARD": "pico2",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "pico2-release",
      "displayName": "pico2 release",
      "binaryDir": "${sourceDir}/build/pico2-release",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/lib/pico-sdk/cmake/preload/toolchains/pico_arm_cortex_m33_gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "pico2",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "pico-debug",
      "configurePreset": "pico-debug"
    },
    {
      "name": "pico-release",
      "configurePreset": "pico-release"
    },
    {
      "name": "pico2-debug",
      "configurePreset": "pico2-debug"
    },
    {
      "name": "pico2-release",
      "configurePreset": "pico2-release"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
